# ==========================
# Haya Building A
# Environment Configuration
# ==========================

# Application
APP_NAME=Haya Building A
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:password@db:5432/haya_building_a

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AI Provider
OPENAI_API_KEY=

# Uploads
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:300
