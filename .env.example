# =====================================
# Haya Building A Configuration
# =====================================

# Application
APP_NAME=Haya Building A
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql://postgres:password@db:5432/haya_building_a

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760

# Logging
LOG_LEVEL=INFO
